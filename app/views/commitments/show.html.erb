<% content_for :title, @commitment.title %>

<div class="max-w-xl mx-auto mt-8 px-4">
  <div class="mb-6 flex items-center justify-between">
    <%= link_to "← Commitments", commitments_path, class: "text-sm text-base-content/60 hover:text-primary transition-colors" %>
    <div class="flex items-center gap-2">
      <%= link_to "Edit", edit_commitment_path(@commitment), class: "btn btn-ghost btn-xs" %>
      <%= button_to "Delete", @commitment, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-ghost btn-xs text-error" %>
    </div>
  </div>

  <div class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body p-6">
      <div class="flex items-start justify-between gap-3">
        <h1 class="text-2xl font-display font-semibold text-base-content"><%= @commitment.title %></h1>
        <span class="badge <%= state_badge_class(@commitment.state) %>"><%= @commitment.state.humanize %></span>
      </div>

      <%# Level 1 metadata %>
      <div class="flex flex-wrap items-center gap-3 mt-3 text-sm text-base-content/70">
        <% if @commitment.category %>
          <span class="font-medium"><%= @commitment.category.name %></span>
        <% end %>
        <% if @commitment.capability %>
          <span class="badge badge-sm badge-outline"><%= @commitment.capability.humanize %></span>
        <% end %>
        <% if @commitment.estimate_minutes %>
          <span class="text-xs text-base-content/50"><%= @commitment.estimate_minutes %> min estimate</span>
        <% end %>
        <% if @commitment.due_at %>
          <span class="text-xs font-semibold text-warning"><%= human_due_date(@commitment.due_at) %></span>
        <% end %>
      </div>

      <%# Level 2 — Details %>
      <% if @commitment.description.present? %>
        <div class="mt-5 pt-4 border-t border-base-200">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-base-content/40 mb-1">Description</h3>
          <p class="text-sm text-base-content/80 whitespace-pre-wrap"><%= @commitment.description %></p>
        </div>
      <% end %>

      <% if @commitment.context.present? %>
        <div class="mt-4 pt-3 border-t border-base-200">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-base-content/40 mb-1">Context Notes</h3>
          <p class="text-sm text-base-content/70 italic whitespace-pre-wrap"><%= @commitment.context %></p>
        </div>
      <% end %>

      <%# Level 3 — Dependencies & Event History %>
      <% if @commitment.dependencies.any? || @commitment.dependents.any? %>
        <div class="mt-4 pt-3 border-t border-base-200">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-base-content/40 mb-2">Dependencies</h3>
          <% if @commitment.dependencies.any? %>
            <div class="text-sm text-base-content/70">
              <span class="text-xs text-base-content/50">Depends on:</span>
              <ul class="list-disc list-inside ml-2">
                <% @commitment.dependencies.each do |dep| %>
                  <li><%= link_to dep.title, dep, class: "hover:underline" %> (<%= dep.state %>)</li>
                <% end %>
              </ul>
            </div>
          <% end %>
          <% if @commitment.dependents.any? %>
            <div class="text-sm text-base-content/70 mt-2">
              <span class="text-xs text-base-content/50">Blocks:</span>
              <ul class="list-disc list-inside ml-2">
                <% @commitment.dependents.each do |dep| %>
                  <li><%= link_to dep.title, dep, class: "hover:underline" %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if @commitment.operator_events.any? %>
        <div class="collapse collapse-arrow bg-base-200/30 rounded-lg mt-5">
          <input type="checkbox" />
          <div class="collapse-title text-xs font-semibold uppercase tracking-wider text-base-content/50 py-3 min-h-0">
            Event History (<%= @commitment.operator_events.count %>)
          </div>
          <div class="collapse-content">
            <ul class="space-y-2 text-xs text-base-content/70">
              <% @commitment.operator_events.order(created_at: :desc).each do |event| %>
                <li class="flex items-center justify-between py-1 border-b border-base-200/50 last:border-0">
                  <span class="font-medium"><%= event.event_type.humanize %></span>
                  <span class="text-base-content/40"><%= event.created_at.strftime("%b %-d, %H:%M") %></span>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <%# Actions %>
      <div class="card-actions mt-6 pt-4 border-t border-base-200 flex gap-2">
        <% unless @commitment.done? %>
          <%= button_to "Complete", complete_commitment_path(@commitment), method: :post, class: "btn btn-primary btn-sm flex-1" %>
        <% end %>
        <%= button_to "Defer", defer_commitment_path(@commitment), method: :post, class: "btn btn-ghost btn-sm flex-1" %>
        <% unless @commitment.archived? %>
          <%= button_to "Archive", archive_commitment_path(@commitment), method: :post, class: "btn btn-ghost btn-sm text-base-content/50 flex-1" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
