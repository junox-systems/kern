<%# After completing a commitment, re-run the pipeline and replace the recommendation card. %>

<% recommendations = Kern::Engine::Pipeline.run(operator: Current.operator, current_time: Time.current) %>
<% @primary = recommendations.find(&:primary?) %>

<%= turbo_stream.replace "primary_recommendation" do %>
  <%= turbo_frame_tag "primary_recommendation" do %>
    <% if @primary %>
      <%= render "dashboard/recommendation_card", recommendation: @primary %>
    <% else %>
      <%= render "dashboard/empty_state" %>
    <% end %>
  <% end %>
<% end %>
