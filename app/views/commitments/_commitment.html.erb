<%# Commitment partial — used in index listing.
     Shows title, state badge, category, capability, and due date. %>

<div id="<%= dom_id commitment %>" class="flex items-center justify-between py-3 px-4 rounded-lg hover:bg-base-200/50 transition-colors border-b border-base-200 last:border-0">
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2">
      <%= link_to commitment.title, commitment, class: "text-sm font-medium text-base-content hover:text-primary transition-colors truncate" %>
      <span class="badge badge-xs <%= state_badge_class(commitment.state) %>"><%= commitment.state.humanize %></span>
    </div>
    <div class="flex items-center gap-2 mt-1">
      <% if commitment.category %>
        <span class="text-xs text-base-content/50"><%= commitment.category.name %></span>
      <% end %>
      <% if commitment.capability %>
        <span class="badge badge-xs badge-ghost"><%= commitment.capability.humanize %></span>
      <% end %>
      <% if commitment.due_at %>
        <span class="text-xs text-base-content/40"><%= human_due_date(commitment.due_at) %></span>
      <% end %>
    </div>
  </div>
  <% if commitment.estimate_minutes %>
    <span class="text-xs text-base-content/30 ml-4"><%= commitment.estimate_minutes %>m</span>
  <% end %>
</div>
