<%= form_with(model: calendar_block, class: "space-y-4") do |form| %>
  <% if calendar_block.errors.any? %>
    <div role="alert" class="alert alert-error alert-sm">
      <div>
        <p class="font-semibold"><%= pluralize(calendar_block.errors.count, "error") %>:</p>
        <ul class="list-disc list-inside text-sm mt-1">
          <% calendar_block.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div>
    <%= form.label :calendar_id, "Calendar", class: "label text-sm font-medium" %>
    <%= form.collection_select :calendar_id, Current.operator.calendars, :id, :name,
          {},
          { class: "select select-bordered w-full" } %>
  </div>

  <div>
    <%= form.label :category_id, "Category", class: "label text-sm font-medium" %>
    <%= form.collection_select :category_id, Current.operator.categories, :id, :name,
          { include_blank: "Select category..." },
          { class: "select select-bordered w-full" } %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= form.label :capability, class: "label text-sm font-medium" %>
      <%= form.select :capability,
            CalendarBlock.capabilities.keys.map { |c| [c.humanize, c] },
            { include_blank: "Any capability" },
            { class: "select select-bordered w-full" } %>
    </div>

    <div>
      <%= form.label :block_type, class: "label text-sm font-medium" %>
      <%= form.select :block_type,
            CalendarBlock.block_types.keys.map { |t| [t.humanize, t] },
            {},
            { class: "select select-bordered w-full" } %>
    </div>
  </div>

  <div>
    <%= form.label :date, class: "label text-sm font-medium" %>
    <%= form.date_field :date, class: "input input-bordered w-full", required: true %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= form.label :start_time, class: "label text-sm font-medium" %>
      <%= form.time_field :start_time, class: "input input-bordered w-full", required: true %>
    </div>

    <div>
      <%= form.label :end_time, class: "label text-sm font-medium" %>
      <%= form.time_field :end_time, class: "input input-bordered w-full", required: true %>
    </div>
  </div>

  <div class="pt-2">
    <%= form.submit class: "btn btn-primary w-full" %>
  </div>
<% end %>
