<div id="<%= dom_id calendar_block %>" class="card bg-base-100 border border-base-300 shadow-sm p-4 hover:border-base-400 transition-colors">
  <div class="flex items-center justify-between">
    <div>
      <div class="flex items-center gap-2">
        <%= link_to calendar_block.category&.name || "Uncategorized Block", calendar_block, class: "text-base font-semibold font-display text-base-content hover:text-primary transition-colors" %>
        <%= render Shared::CapabilityBadgeComponent.new(capability: calendar_block.capability, size: :xs) %>
        <span class="badge badge-xs badge-ghost"><%= calendar_block.block_type.humanize %></span>
      </div>
      <p class="text-xs text-base-content/60 mt-1">
        <%= calendar_block.date.strftime("%a, %b %-d") %> •
        <%= calendar_block.start_time.strftime("%H:%M") %> – <%= calendar_block.end_time.strftime("%H:%M") %>
      </p>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "Edit", edit_calendar_block_path(calendar_block), class: "btn btn-ghost btn-xs" %>
    </div>
  </div>
</div>
