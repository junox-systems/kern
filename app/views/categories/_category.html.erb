<div id="<%= dom_id category %>" class="card bg-base-100 border border-base-300 shadow-sm p-4 hover:border-base-400 transition-colors">
  <div class="flex items-center justify-between">
    <div class="flex-1">
      <div class="flex items-center gap-2">
        <%= link_to category.name, category, class: "text-base font-semibold font-display text-base-content hover:text-primary transition-colors" %>
        <span class="badge badge-sm badge-ghost">Priority <%= category.priority %></span>
      </div>
      <% if category.description.present? %>
        <p class="text-xs text-base-content/60 mt-1"><%= category.description %></p>
      <% end %>
    </div>
    <div class="text-right ml-4">
      <p class="text-sm font-medium text-base-content">
        <%= (category.weekly_allocation_minutes / 60.0).round(1) %>h / wk
      </p>
      <div class="flex justify-end gap-2 mt-2">
        <%= link_to "Edit", edit_category_path(category), class: "btn btn-ghost btn-xs" %>
      </div>
    </div>
  </div>
</div>
