<% content_for :title, @category.name %>

<div class="max-w-xl mx-auto mt-8 px-4">
  <div class="mb-6 flex items-center justify-between">
    <%= link_to "← Categories", categories_path, class: "text-sm text-base-content/60 hover:text-primary transition-colors" %>
    <div class="flex items-center gap-2">
      <%= link_to "Edit", edit_category_path(@category), class: "btn btn-ghost btn-xs" %>
      <%= button_to "Delete", @category, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-ghost btn-xs text-error" %>
    </div>
  </div>

  <div class="card bg-base-100 border border-base-300 shadow-sm p-6">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-display font-semibold text-base-content"><%= @category.name %></h1>
      <span class="badge badge-outline">Priority <%= @category.priority %></span>
    </div>

    <% if @category.description.present? %>
      <p class="text-sm text-base-content/70 mt-3"><%= @category.description %></p>
    <% end %>

    <div class="mt-6 pt-4 border-t border-base-200 grid grid-cols-2 gap-4 text-sm">
      <div>
        <span class="text-xs text-base-content/50 uppercase">Weekly Target</span>
        <p class="font-medium text-base-content"><%= (@category.weekly_allocation_minutes / 60.0).round(1) %> hours</p>
      </div>
      <div>
        <span class="text-xs text-base-content/50 uppercase">Active Commitments</span>
        <p class="font-medium text-base-content"><%= @category.commitments.ready.count %> ready</p>
      </div>
    </div>
  </div>
</div>
